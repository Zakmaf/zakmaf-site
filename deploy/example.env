# Copier en .env à côté de compose.example.yml (ou saisir dans les variables de la pile
# Portainer). Ne jamais commiter le fichier rempli.

# Mots de passe MySQL (longs, aléatoires : openssl rand -base64 32)
MYSQL_ROOT_PASSWORD=
GHOST_DB_PASSWORD=

# Clé de la Content API : Ghost Admin > Settings > Integrations > Add custom integration
GHOST_CONTENT_KEY=

# Articles fictifs ajoutés au site (0 en production)
MOCK_POSTS=0
