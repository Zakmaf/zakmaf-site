---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/ghost.js';
import { imgProps, SIZES } from '../../lib/images.js';
import TopicChips from '../../components/TopicChips.astro';
import { existsSync } from 'node:fs';
import { LABELS, AUTHOR, SOCIALS } from '../../lib/site.js';
export async function getStaticPaths() {
  const posts = await getPosts();
  const link = (p) => (p ? { title: p.title, href: `/${p.section}/${p.slug}/` } : null);
  return posts.map((p) => {
    const siblings = posts.filter((q) => q.section === p.section);
    const i = siblings.indexOf(p);
    return {
      params: { section: p.section, slug: p.slug },
      props: { post: p, newer: link(siblings[i - 1]), older: link(siblings[i + 1]) },
    };
  });
}
const { post, newer, older } = Astro.props;
const hasPhoto = existsSync(`public${AUTHOR.photo}`);
const youtube = SOCIALS.find((s) => s.label === 'YouTube')?.url;
const github = SOCIALS.find((s) => s.label === 'GitHub')?.url;
const date = new Date(post.published_at).toLocaleDateString('fr-FR', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---
<Base title={post.title} image={post.feature_image} description={post.custom_excerpt ?? post.excerpt}>
  <article class="narrow" data-pagefind-body>
    <header class="post-head">
      <div class="post-tags" data-pagefind-ignore>
        <a class="crumb" href={`/${post.section}/`} data-pagefind-meta="section">{LABELS[post.section]}</a>
        <TopicChips topics={post.topics} />
      </div>
      <h1>{post.title}</h1>
      <div class="meta" data-pagefind-ignore>
        <time datetime={post.published_at}>{date}</time>
        {post.reading_time ? ` · ${post.reading_time} min de lecture` : ''}
      </div>
      {post.videoUrl && !post.feature_image && <p class="watch"><a href={post.videoUrl}>Regarder la vidéo sur YouTube →</a></p>}
    </header>
    {post.feature_image && (post.videoUrl ? (
      <a class="cover-link" href={post.videoUrl} aria-label={`Regarder : ${post.title}`}>
        <img class="cover" src={post.feature_image} alt="" {...imgProps(post.feature, SIZES.cover)} />
        <span class="watch-pill" aria-hidden="true">Regarder la vidéo</span>
      </a>
    ) : (
      <img class="cover" src={post.feature_image} alt="" {...imgProps(post.feature, SIZES.cover)} />
    ))}
    {post.toc.length > 0 && (
      <nav class="toc" aria-labelledby="toc-title" data-pagefind-ignore>
        <details open>
          <summary id="toc-title">Sommaire</summary>
          <ol>
            {post.toc.map((h) => (
              <li>
                <a href={`#${h.id}`}>{h.text}</a>
                {h.children.length > 0 && (
                  <ul>{h.children.map((c) => <li><a href={`#${c.id}`}>{c.text}</a></li>)}</ul>
                )}
              </li>
            ))}
          </ol>
        </details>
      </nav>
    )}
    <div class="body"><Fragment set:html={post.html} /></div>
    {post.files.length > 0 && (
      <aside class="files" data-pagefind-ignore>
        <span class="files-head">Les fichiers de cette vidéo</span>
        {post.files.map((f) => (
          <a class="files-item" href={f.href}>
            <span class="files-name">
              {f.file && <span class="files-path">{f.file}</span>}
              <span>{f.title}</span>
            </span>
            {f.lang && <span class="file-lang">{f.lang}</span>}
          </a>
        ))}
      </aside>
    )}
    <section class="author" aria-label="L'auteur" data-pagefind-ignore>
      {hasPhoto && <img src={AUTHOR.photo} alt="" width="72" height="72" loading="lazy" />}
      <div>
        <p class="author-name"><a href="/a-propos/">{AUTHOR.name}</a></p>
        <p class="author-bio">{AUTHOR.short}</p>
        <p class="author-links">
          {youtube && <a href={youtube} rel="me noopener">S'abonner sur YouTube</a>}
          {github && <a href={github} rel="me noopener">GitHub</a>}
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </section>
  </article>
  {(older || newer) && (
    <nav class="post-nav narrow" aria-label="Autres articles">
      {older && <a class="prev" href={older.href}><span>← Plus ancien</span>{older.title}</a>}
      {newer && <a class="next" href={newer.href}><span>Plus récent →</span>{newer.title}</a>}
    </nav>
  )}
</Base>
