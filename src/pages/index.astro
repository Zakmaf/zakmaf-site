---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import TopicChips from '../components/TopicChips.astro';
import { getPosts, getTopics, SECTIONS } from '../lib/ghost.js';
import { imgProps, SIZES } from '../lib/images.js';
import { SITE, LABELS, INTROS, AUTHOR, SOCIALS } from '../lib/site.js';
const posts = await getPosts();
const topics = await getTopics();
const hasPhoto = existsSync(`public${AUTHOR.photo}`);
const channelUrl = SOCIALS.find((s) => s.label === 'YouTube')?.url;
const fmt = (d) =>
  new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

// À la une : le dernier article Vidéos (sinon le dernier article).
const lead = posts.find((p) => p.section === 'videos') ?? posts[0] ?? null;
const featured = lead
  ? {
      href: `/${lead.section}/${lead.slug}/`,
      title: lead.title,
      image: lead.feature_image ?? `/covers/${lead.section}.svg`,
      info: lead.feature_image ? lead.feature : null,
      date: lead.published_at,
      kind: lead.videoUrl ? 'Vidéo + article' : LABELS[lead.section],
      play: Boolean(lead.videoUrl),
      videoUrl: lead.videoUrl,
    }
  : null;

// Sections de l'accueil : celles qui ont au moins un article, sans répéter l'article à la une.
const sections = SECTIONS.map((slug) => ({
  slug,
  posts: posts.filter((p) => p.section === slug && p !== lead).slice(0, 4),
})).filter((s) => s.posts.length > 0);
---
<Base description={AUTHOR.bio}>
  <div class="home-top">
    <section class="hero">
      <span class="label eyebrow">Carnet de bord · homelab &amp; auto-hébergement</span>
      <h1>{SITE.title}</h1>
      <p class="tagline">{SITE.description}</p>
      <div class="hero-bio">
        {hasPhoto && <img src={AUTHOR.photo} alt={AUTHOR.name} width="80" height="80" />}
        <p class="bio"><strong>{AUTHOR.name}.</strong> {AUTHOR.bio} <a href="/a-propos/">En savoir plus</a></p>
      </div>
      <p class="actions">
        {channelUrl && <a class="btn btn-primary" href={channelUrl} rel="me noopener">S'abonner sur YouTube</a>}
        <a class="btn" href="/boilerplate/">Les fichiers prêts à copier</a>
      </p>
    </section>
    {featured && (
      <article class="featured">
        <div class="featured-head">
          <span class="label">À la une</span>
          <span class="label muted">{featured.kind}</span>
        </div>
        <a class="featured-cover" href={featured.href} tabindex="-1" aria-hidden="true">
          {featured.image && <img src={featured.image} alt="" {...imgProps(featured.info, SIZES.featured)} />}
          {featured.play && <span class="play"></span>}
        </a>
        <h2><a href={featured.href}>{featured.title}</a></h2>
        <p class="meta">
          {featured.date && fmt(featured.date)}
          {featured.videoUrl && <> · <a href={featured.videoUrl}>Regarder sur YouTube →</a></>}
        </p>
      </article>
    )}
  </div>
  {sections.map((s, i) => (
    <section>
      <div class="section-head">
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        <h2>{LABELS[s.slug]}</h2>
        <span class="rule" aria-hidden="true"></span>
        <a href={`/${s.slug}/`}>Tout voir →</a>
      </div>
      <p class="intro">{INTROS[s.slug]}</p>
      <PostList posts={s.posts} />
    </section>
  ))}
  {topics.length > 0 && (
    <section>
      <div class="section-head">
        <span class="num">{String(sections.length + 1).padStart(2, '0')}</span>
        <h2>Thèmes</h2>
        <span class="rule" aria-hidden="true"></span>
        <a href="/themes/">Tout voir →</a>
      </div>
      <TopicChips topics={topics.slice(0, 12)} count />
    </section>
  )}
</Base>
