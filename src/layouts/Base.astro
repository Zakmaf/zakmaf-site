---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import { SITE, LABELS, SOCIALS, AUTHOR } from '../lib/site.js';
import '../styles/extra.css';
const { title, description = SITE.description, image } = Astro.props;
const fullTitle = title ? `${title} – ${SITE.title}` : SITE.homeTitle;
const current = Astro.url.pathname.split('/')[1];
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.homeTitle} href="/rss.xml" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.homeTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="stylesheet" href="/ghost/cards.min.css" />
    <script is:inline defer src="/ghost/cards.min.js"></script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">{SITE.brand}</a>
      <nav>
        {Object.entries(LABELS).map(([slug, label]) => (
          <a href={`/${slug}/`} aria-current={current === slug ? 'page' : undefined}>{label}</a>
        ))}
        <a href="/a-propos/" aria-current={current === "a-propos" ? "page" : undefined}>À propos</a>
        <button id="theme-toggle" type="button" aria-label="Changer de thème">◐</button>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {AUTHOR.name}</span>
      <span class="socials">{SOCIALS.filter((s) => s.url).map((s) => <a href={s.url} rel="me noopener">{s.label}</a>)}<a href="/rss.xml">RSS</a></span>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
      document.querySelectorAll('article pre').forEach((pre) => {
        const code = pre.querySelector('code');
        if (!code) return;
        const b = document.createElement('button');
        b.className = 'copy';
        b.type = 'button';
        b.textContent = 'Copier';
        b.addEventListener('click', async () => {
          await navigator.clipboard.writeText(code.innerText);
          b.textContent = 'Copié';
          setTimeout(() => (b.textContent = 'Copier'), 1500);
        });
        pre.append(b);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f7f5f0; --surface: #ffffff; --fg: #1f1e1c; --muted: #6f6b63; --line: #e2ded5; --accent: #b23a0e;
    --serif: 'Newsreader Variable', Georgia, 'Times New Roman', serif;
    --sans: system-ui, -apple-system, 'Segoe UI', sans-serif;
    --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    --ghost-accent-color: var(--accent);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;
      --bg: #171614; --surface: #1f1e1b; --fg: #ebe7df; --muted: #a09a8f; --line: #302e2a; --accent: #f08a5d;
    }
  }
  :root[data-theme='dark'] {
    color-scheme: dark;
    --bg: #171614; --surface: #1f1e1b; --fg: #ebe7df; --muted: #a09a8f; --line: #302e2a; --accent: #f08a5d;
  }

  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 1rem/1.6 var(--sans); }
  a { color: var(--accent); text-underline-offset: 3px; }
  .site-header, main, .site-footer { max-width: 46rem; margin-inline: auto; padding-inline: 1.25rem; }

  .site-header {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: .5rem 1.5rem; padding-block: 1.25rem; border-bottom: 1px solid var(--line);
  }
  .brand { font: 700 1.3rem/1 var(--serif); text-decoration: none; color: var(--fg); }
  nav { display: flex; align-items: center; gap: 1.25rem; font-size: .95rem; }
  nav a { text-decoration: none; color: var(--muted); padding-block: .25rem; border-bottom: 2px solid transparent; }
  nav a:hover { color: var(--fg); }
  nav a[aria-current='page'] { color: var(--fg); border-bottom-color: var(--accent); }
  #theme-toggle {
    font: inherit; font-size: 1.1rem; line-height: 1; padding: .3rem .45rem; cursor: pointer;
    color: var(--muted); background: none; border: 1px solid var(--line); border-radius: 6px;
  }
  #theme-toggle:hover { color: var(--fg); }

  main { padding-block: 2.5rem 3.5rem; }
  h1, h2, h3 { font-family: var(--serif); text-wrap: balance; }
  h1 { font-size: 2.4rem; line-height: 1.15; margin: 0 0 .75rem; font-weight: 650; }
  .meta { color: var(--muted); font-size: .875rem; }

  .masthead { padding-block: 1rem 2rem; border-bottom: 1px solid var(--line); }
  .masthead h1 { font-size: clamp(2.4rem, 7vw, 3.4rem); margin-bottom: .5rem; }
  .masthead p { margin: 0; font: italic 1.25rem/1.4 var(--serif); color: var(--muted); }

  .section-head { display: flex; justify-content: space-between; align-items: baseline; margin: 2.75rem 0 .25rem; }
  .section-head h2 { font-size: 1.5rem; margin: 0; }
  .section-head a { font-size: .875rem; text-decoration: none; }

  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-list li { display: flex; gap: 1.25rem; align-items: flex-start; padding-block: 1.25rem; border-bottom: 1px solid var(--line); }
  .post-list .text { flex: 1; min-width: 0; }
  .post-list a.title { font: 600 1.3rem/1.25 var(--serif); color: var(--fg); text-decoration: none; }
  .post-list a.title:hover { color: var(--accent); }
  .post-list p { margin: .35rem 0 0; color: var(--muted); font-size: .95rem; }
  .post-list img { width: 7rem; height: 5rem; object-fit: cover; border-radius: 6px; flex: none; }
  @media (max-width: 30rem) { .post-list img { width: 4.5rem; height: 4.5rem; } }

  .crumb { font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; }
  .post-head { margin-bottom: 2rem; }
  .post-head h1 { margin-top: .5rem; }
  .cover { display: block; width: 100%; height: auto; margin: 0 0 2rem; border-radius: 8px; }

  article .body { font: 1.2rem/1.65 var(--serif); }
  article .body h2 { font-size: 1.7rem; line-height: 1.25; margin: 2.5rem 0 .75rem; }
  article .body h3 { font-size: 1.35rem; line-height: 1.3; margin: 2rem 0 .5rem; }
  article .body img, article .body video { max-width: 100%; height: auto; border-radius: 6px; }
  article .body iframe { width: 100%; height: auto; aspect-ratio: 16 / 9; border: 0; border-radius: 6px; }
  article .body figure { margin: 2rem 0; }
  article .body figcaption { font: .85rem/1.4 var(--sans); color: var(--muted); text-align: center; margin-top: .5rem; }
  article .body blockquote { margin: 1.75rem 0; padding-left: 1.1rem; border-left: 3px solid var(--accent); font-style: italic; color: var(--muted); }
  article .body hr { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0; }
  article .body table { width: 100%; border-collapse: collapse; font: .95rem/1.5 var(--sans); display: block; overflow-x: auto; }
  article .body th, article .body td { padding: .5rem .75rem; border-bottom: 1px solid var(--line); text-align: left; }
  article .body code { font-family: var(--mono); font-size: .82em; background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: .1em .35em; }
  article .body pre {
    position: relative; overflow-x: auto; padding: 1rem 1.1rem; margin: 1.75rem 0;
    border: 1px solid var(--line); border-radius: 8px; font: .875rem/1.55 var(--mono);
  }
  article .body pre code { font-size: 1em; background: none; border: 0; padding: 0; }
  @media (min-width: 60rem) {
    article .body .kg-width-wide { margin-inline: -5rem; }
  }

  .shiki, .shiki span { color: var(--shiki-light); background-color: var(--shiki-light-bg); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .shiki,
    :root:not([data-theme='light']) .shiki span { color: var(--shiki-dark); background-color: var(--shiki-dark-bg); }
  }
  :root[data-theme='dark'] .shiki,
  :root[data-theme='dark'] .shiki span { color: var(--shiki-dark); background-color: var(--shiki-dark-bg); }

  .copy {
    position: absolute; top: .5rem; right: .5rem; padding: .15rem .6rem; cursor: pointer;
    font: .75rem/1.5 var(--sans); color: var(--muted); background: var(--bg);
    border: 1px solid var(--line); border-radius: 4px;
  }
  .copy:hover { color: var(--fg); }

  .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .post-nav a { text-decoration: none; color: var(--fg); font: 600 1.1rem/1.3 var(--serif); }
  .post-nav a:hover { color: var(--accent); }
  .post-nav span { display: block; font: .8rem/1.6 var(--sans); color: var(--muted); }
  .post-nav .next { text-align: right; grid-column: 2; }

  .site-footer {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1.5rem;
    padding-block: 1.75rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .875rem;
  }
</style>
