---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import { SITE, LABELS, SOCIALS, AUTHOR } from '../lib/site.js';
import { getTopics } from '../lib/ghost.js';
import pkg from '../../package.json';
import '../styles/global.css';
// seo : champs SEO et de partage saisis dans Ghost (voir seoOf dans ghost.js), chacun facultatif.
// article : date de publication, de mise à jour, section et thèmes d'un article.
const { title, description = SITE.description, seo = {}, article } = Astro.props;
const fullTitle = seo.title || (title ? `${title} – ${SITE.title}` : SITE.homeTitle);
const current = Astro.url.pathname.split('/')[1];
const canonical = seo.canonical || new URL(Astro.url.pathname, Astro.site);
const og = seo.og ?? {};
const twitter = seo.twitter ?? {};
// Image de partage : celle de Ghost, sinon image par défaut (dimensions connues).
const ogImage = og.image ?? {
  src: '/og-default.png', type: 'image/png', width: 1200, height: 630, alt: `${SITE.title} – ${SITE.brand}`,
};
const absolute = (src) => new URL(src, Astro.site);
// Signature « zakmaf.net » : point en paprika, extension en italique.
const [brandName, brandTld] = SITE.brand.split('.');
const year = new Date().getFullYear();
// Version publiée (package.json, alignée sur le tag de la release GitHub).
const version = `v${pkg.version}`;
const hasTopics = (await getTopics()).length > 0;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.homeTitle} href="/rss.xml" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={og.title || title || SITE.homeTitle} />
    <meta property="og:description" content={og.description || description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={absolute(ogImage.src)} />
    {ogImage.type && <meta property="og:image:type" content={ogImage.type} />}
    {ogImage.width && <meta property="og:image:width" content={ogImage.width} />}
    {ogImage.height && <meta property="og:image:height" content={ogImage.height} />}
    {ogImage.alt && <meta property="og:image:alt" content={ogImage.alt} />}
    {article && <meta property="article:published_time" content={article.published} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    {twitter.title && <meta name="twitter:title" content={twitter.title} />}
    {twitter.description && <meta name="twitter:description" content={twitter.description} />}
    {twitter.image && <meta name="twitter:image" content={absolute(twitter.image.src)} />}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="stylesheet" href="/ghost/cards.min.css" />
    <script is:inline defer src="/ghost/cards.min.js"></script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">{brandName}<span class="dot">.</span><span class="tld">{brandTld}</span></a>
      <nav>
        {Object.entries(LABELS).map(([slug, label]) => (
          <a href={`/${slug}/`} aria-current={current === slug ? 'page' : undefined}>{label}</a>
        ))}
        {hasTopics && <a href="/themes/" aria-current={current === 'themes' ? 'page' : undefined}>Thèmes</a>}
        <a href="/a-propos/" aria-current={current === "a-propos" ? "page" : undefined}>À propos</a>
        <a href="/recherche/" aria-current={current === 'recherche' ? 'page' : undefined}>Recherche</a>
        <button id="theme-toggle" type="button" aria-label="Changer de thème">◐</button>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-id">
          <a class="brand" href="/">{brandName}<span class="dot">.</span><span class="tld">{brandTld}</span></a>
          <p class="tagline">{SITE.description}</p>
        </div>
        <div class="footer-col">
          <span class="label">Sections</span>
          {Object.entries(LABELS).map(([slug, label]) => <a href={`/${slug}/`}>{label}</a>)}
          {hasTopics && <a href="/themes/">Thèmes</a>}
          <a href="/a-propos/">À propos</a>
          <a href="/recherche/">Recherche</a>
        </div>
        <div class="footer-col">
          <span class="label">Ailleurs</span>
          {SOCIALS.filter((s) => s.url).map((s) => <a href={s.url} rel="me noopener">{s.label}</a>)}
          <a href="/rss.xml">RSS</a>
        </div>
        <p class="footer-legal">© {year} {AUTHOR.name} · <a href="https://github.com/Zakmaf/zakmaf-site">code source sur GitHub</a> · <a href={`https://github.com/Zakmaf/zakmaf-site/releases/tag/${version}`}>{version}</a></p>
      </div>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
      document.querySelectorAll('article pre').forEach((pre) => {
        const code = pre.querySelector('code');
        if (!code) return;
        const b = document.createElement('button');
        b.className = 'copy';
        b.type = 'button';
        b.textContent = 'Copier';
        b.addEventListener('click', async () => {
          await navigator.clipboard.writeText(code.innerText);
          b.textContent = 'Copié';
          setTimeout(() => (b.textContent = 'Copier'), 1500);
        });
        pre.append(b);
      });
    </script>
  </body>
</html>

