---
const { posts } = Astro.props;
const fmt = (d) =>
  new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
{posts.length === 0 && !Astro.slots.has('default') ? (
  <p class="meta">Aucun article pour le moment.</p>
) : (
  <ul class="post-list">
    {posts.map((p) => (
      p.code ? (
        <li class="file">
          <a class="file-card" href={`/${p.section}/${p.slug}/`}>
            <span class="file-tab">
              <span class="file-name">{p.code.file ?? p.code.lang}</span>
              {p.code.file && <span class="file-lang">{p.code.lang}</span>}
            </span>
            <span class="file-preview" set:html={p.code.preview} />
            <span class="file-body">
              <span class="title">{p.title}</span>
              <span class="meta">
                {fmt(p.published_at)}
                {p.reading_time ? ` · ${p.reading_time} min de lecture` : ''}
              </span>
            </span>
          </a>
        </li>
      ) : (
        <li>
          <div class="text">
            <a class="title" href={`/${p.section}/${p.slug}/`}>{p.title}</a>
            <div class="meta">
              {fmt(p.published_at)}
              {p.reading_time ? ` · ${p.reading_time} min de lecture` : ''}
            </div>
            {p.excerpt && <p>{p.excerpt}</p>}
          </div>
          <img src={p.feature_image ?? `/covers/${p.section}.svg`} class={p.feature_image ? undefined : 'fallback'} alt="" loading="lazy" />
        </li>
      )
    ))}
    <slot />
  </ul>
)}
